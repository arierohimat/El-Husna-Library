  <!-- Page 3: Flowchart Algoritma K-Means -->
  <diagram id="fc-kmeans" name="3. Flowchart Algoritma K-Means">
    <mxGraphModel dx="1246" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="p3_0" />
        <mxCell id="p3_1" parent="p3_0" />

        <mxCell id="p3_title" parent="p3_1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" value="Flowchart — Algoritma K-Means Clustering Minat Baca" vertex="1">
          <mxGeometry height="40" width="550" x="180" y="15" as="geometry" />
        </mxCell>

        <mxCell id="p3_L1" parent="p3_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="START" vertex="1">
          <mxGeometry height="50" width="120" x="370" y="70" as="geometry" />
        </mxCell>

        <mxCell id="p3_L2" parent="p3_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Ambil dataset anggota:&#xa;[totalBorrow, totalReturn, totalEbook]" vertex="1">
          <mxGeometry height="50" width="220" x="320" y="150" as="geometry" />
        </mxCell>

        <mxCell id="p3_L3" parent="p3_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Dataset anggota&#xa;tersedia (&gt; 0)?" vertex="1">
          <mxGeometry height="80" width="160" x="350" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p3_L4" parent="p3_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=10;" value="Throw Error&#xa;&quot;Data anggota belum&#xa;tersedia&quot;" vertex="1">
          <mxGeometry height="50" width="170" x="130" y="245" as="geometry" />
        </mxCell>
        <mxCell id="p3_L4end" parent="p3_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="END" vertex="1">
          <mxGeometry height="50" width="120" x="155" y="320" as="geometry" />
        </mxCell>

        <mxCell id="p3_L5" parent="p3_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Urutkan data komposit &amp;&#xa;set centroid awal (K=3)" vertex="1">
          <mxGeometry height="50" width="190" x="335" y="360" as="geometry" />
        </mxCell>

        <mxCell id="p3_L6" parent="p3_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Hitung Euclidean Distance 3D&#xa;&amp; alokasi cluster terdekat" vertex="1">
          <mxGeometry height="50" width="200" x="330" y="440" as="geometry" />
        </mxCell>

        <mxCell id="p3_L7" parent="p3_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Update centroid baru&#xa;(rata-rata vektor cluster)" vertex="1">
          <mxGeometry height="50" width="190" x="335" y="520" as="geometry" />
        </mxCell>

        <mxCell id="p3_L8" parent="p3_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Cluster stabil /&#xa;konvergen?" vertex="1">
          <mxGeometry height="80" width="160" x="350" y="600" as="geometry" />
        </mxCell>

        <mxCell id="p3_L9" parent="p3_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Mapping label cluster:&#xa;Tinggi, Sedang, Rendah" vertex="1">
          <mxGeometry height="50" width="180" x="340" y="720" as="geometry" />
        </mxCell>

        <mxCell id="p3_L10" parent="p3_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Simpan hasil clustering&#xa;ke DB (ClusteringRun)" vertex="1">
          <mxGeometry height="50" width="190" x="335" y="800" as="geometry" />
        </mxCell>

        <mxCell id="p3_L11" parent="p3_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="RETURN Summary JSON&#xa;(centroids &amp; results)" vertex="1">
