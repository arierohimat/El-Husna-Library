  <!-- Page 2: Flowchart Pengembalian Buku -->
  <diagram id="fc-pengembalian" name="2. Flowchart Pengembalian Buku">
    <mxGraphModel dx="1246" dy="627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p2_0" />
        <mxCell id="p2_1" parent="p2_0" />

        <mxCell id="p2_title" parent="p2_1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" value="Flowchart — Alur Pengembalian Buku" vertex="1">
          <mxGeometry height="40" width="500" x="200" y="15" as="geometry" />
        </mxCell>

        <mxCell id="p2_L1" parent="p2_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="START" vertex="1">
          <mxGeometry height="50" width="120" x="370" y="70" as="geometry" />
        </mxCell>

        <mxCell id="p2_L2" parent="p2_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Pilih peminjaman aktif&#xa;(borrowingId)" vertex="1">
          <mxGeometry height="50" width="180" x="340" y="150" as="geometry" />
        </mxCell>

        <mxCell id="p2_L3" parent="p2_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Record ada &amp;&#xa;status = BORROWED?" vertex="1">
          <mxGeometry height="80" width="180" x="340" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p2_L4" parent="p2_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=10;" value="RETURN Error 400&#xa;&quot;Peminjaman tidak&#xa;ditemukan&quot;" vertex="1">
          <mxGeometry height="50" width="170" x="120" y="245" as="geometry" />
        </mxCell>
        <mxCell id="p2_L4end" parent="p2_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="END" vertex="1">
          <mxGeometry height="50" width="120" x="145" y="320" as="geometry" />
        </mxCell>

        <mxCell id="p2_L5" parent="p2_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Update status = RETURNED&#xa;&amp; returnDate = NOW()" vertex="1">
          <mxGeometry height="50" width="190" x="335" y="360" as="geometry" />
        </mxCell>

        <mxCell id="p2_L6" parent="p2_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Update stok buku (+1)" vertex="1">
          <mxGeometry height="50" width="160" x="350" y="440" as="geometry" />
        </mxCell>

        <mxCell id="p2_L7" parent="p2_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="RETURN 200&#xa;&quot;Pengembalian berhasil&quot;" vertex="1">
          <mxGeometry height="50" width="180" x="340" y="520" as="geometry" />
        </mxCell>

        <mxCell id="p2_L8" parent="p2_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="END" vertex="1">
          <mxGeometry height="50" width="120" x="370" y="600" as="geometry" />
        </mxCell>

        <!-- Edges -->
