<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36" version="29.6.0" pages="5">
  
  <!-- Page 1: Flowchart Login ke Peminjaman -->
  <diagram id="fc-login-peminjaman" name="1. Flowchart Login ke Peminjaman">
    <mxGraphModel dx="1246" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="p1_0" />
        <mxCell id="p1_1" parent="p1_0" />
        
        <mxCell id="p1_title" parent="p1_1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" value="Flowchart — Alur Login Sampai Peminjaman Buku" vertex="1">
          <mxGeometry height="40" width="550" x="180" y="15" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="p1_L1" parent="p1_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="START" vertex="1">
          <mxGeometry height="50" width="120" x="380" y="70" as="geometry" />
        </mxCell>

        <!-- Input Login -->
        <mxCell id="p1_L2" parent="p1_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Input Login&#xa;(email, password)" vertex="1">
          <mxGeometry height="50" width="180" x="350" y="150" as="geometry" />
        </mxCell>

        <!-- Decision 1: Email/Password Kosong? -->
        <mxCell id="p1_L3" parent="p1_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Email / password&#xa;kosong?" vertex="1">
          <mxGeometry height="80" width="160" x="360" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p1_L4" parent="p1_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=10;" value="RETURN Error 400&#xa;&quot;Email dan password&#xa;wajib diisi&quot;" vertex="1">
          <mxGeometry height="50" width="170" x="130" y="245" as="geometry" />
        </mxCell>
        <mxCell id="p1_L4end" parent="p1_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="END" vertex="1">
          <mxGeometry height="50" width="120" x="155" y="320" as="geometry" />
        </mxCell>

        <!-- Decision 2: Pass length < 8? -->
        <mxCell id="p1_L5" parent="p1_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Password &lt; 8&#xa;karakter?" vertex="1">
          <mxGeometry height="80" width="160" x="360" y="360" as="geometry" />
        </mxCell>
        <mxCell id="p1_L6" parent="p1_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=10;" value="RETURN Error 400&#xa;&quot;Password minimal&#xa;8 karakter&quot;" vertex="1">
          <mxGeometry height="50" width="170" x="130" y="375" as="geometry" />
        </mxCell>
        <mxCell id="p1_L6end" parent="p1_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="END" vertex="1">
          <mxGeometry height="50" width="120" x="155" y="450" as="geometry" />
        </mxCell>

        <!-- Process: Query & Bcrypt -->
        <mxCell id="p1_L7" parent="p1_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Query User by Email &amp;&#xa;Verifikasi Bcrypt" vertex="1">
          <mxGeometry height="50" width="180" x="350" y="480" as="geometry" />
        </mxCell>

        <!-- Decision 3: Valid User & Pass? -->
        <mxCell id="p1_L8" parent="p1_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Kredensial Login&#xa;Valid?" vertex="1">
          <mxGeometry height="80" width="160" x="360" y="560" as="geometry" />
        </mxCell>
        <mxCell id="p1_L9" parent="p1_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=10;" value="RETURN Error 401&#xa;&quot;Email atau password&#xa;salah&quot;" vertex="1">
          <mxGeometry height="50" width="170" x="130" y="575" as="geometry" />
        </mxCell>
        <mxCell id="p1_L9end" parent="p1_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="END" vertex="1">
          <mxGeometry height="50" width="120" x="155" y="650" as="geometry" />
        </mxCell>

        <!-- Process: Session & Catalog -->
        <mxCell id="p1_L10" parent="p1_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Buat session &amp; cookie,&#xa;masuk katalog buku" vertex="1">
          <mxGeometry height="50" width="180" x="350" y="680" as="geometry" />
        </mxCell>

        <!-- Input Peminjaman -->
        <mxCell id="p1_L11" parent="p1_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Pilih buku &amp; tanggal&#xa;(bookId, borrowDate, dueDate)" vertex="1">
          <mxGeometry height="50" width="200" x="340" y="760" as="geometry" />
        </mxCell>

        <!-- Decision 4: Tanggal Valid? -->
        <mxCell id="p1_L12" parent="p1_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="dueDate &gt; borrowDate&#xa;&amp; field lengkap?" vertex="1">
          <mxGeometry height="80" width="180" x="350" y="840" as="geometry" />
        </mxCell>
        <mxCell id="p1_L13" parent="p1_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=10;" value="RETURN Error 400&#xa;&quot;Tanggal jatuh tempo&#xa;tidak valid&quot;" vertex="1">
          <mxGeometry height="50" width="170" x="130" y="855" as="geometry" />
        </mxCell>
        <mxCell id="p1_L13end" parent="p1_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="END" vertex="1">
          <mxGeometry height="50" width="120" x="155" y="930" as="geometry" />
        </mxCell>

        <!-- Decision 5: Pinjaman Aktif? -->
        <mxCell id="p1_L14" parent="p1_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Role Member punya&#xa;pinjaman aktif?" vertex="1">
          <mxGeometry height="80" width="180" x="350" y="960" as="geometry" />
        </mxCell>
        <mxCell id="p1_L15" parent="p1_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=10;" value="RETURN Error 400&#xa;&quot;masih memiliki&#xa;peminjaman aktif&quot;" vertex="1">
          <mxGeometry height="50" width="170" x="130" y="975" as="geometry" />
        </mxCell>
        <mxCell id="p1_L15end" parent="p1_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="END" vertex="1">
          <mxGeometry height="50" width="120" x="155" y="1050" as="geometry" />
        </mxCell>

        <!-- Decision 6: Stok Buku Tersedia? -->
        <mxCell id="p1_L16" parent="p1_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Buku ditemukan &amp;&#xa;stok &gt; 0?" vertex="1">
          <mxGeometry height="80" width="160" x="360" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="p1_L17" parent="p1_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=10;" value="RETURN Error 400&#xa;&quot;Buku tidak tersedia&quot;" vertex="1">
          <mxGeometry height="50" width="170" x="130" y="1095" as="geometry" />
        </mxCell>
        <mxCell id="p1_L17end" parent="p1_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="END" vertex="1">
          <mxGeometry height="50" width="120" x="155" y="1170" as="geometry" />
        </mxCell>

        <!-- Process: DB Transaction -->
        <mxCell id="p1_L18" parent="p1_1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="Simpan peminjaman &amp;&#xa;kurangi stok buku (DB)" vertex="1">
          <mxGeometry height="50" width="180" x="350" y="1200" as="geometry" />
        </mxCell>

        <!-- Output Success -->
        <mxCell id="p1_L19" parent="p1_1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=11;" value="RETURN 201&#xa;&quot;Peminjaman berhasil&quot;" vertex="1">
          <mxGeometry height="50" width="180" x="350" y="1280" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="p1_L20" parent="p1_1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" value="END" vertex="1">
          <mxGeometry height="50" width="120" x="380" y="1360" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="p1_e12" edge="1" parent="p1_1" source="p1_L1" style="rounded=1;strokeColor=#000000;" target="p1_L2" />
        <mxCell id="p1_e23" edge="1" parent="p1_1" source="p1_L2" style="rounded=1;strokeColor=#000000;" target="p1_L3" />
        <mxCell id="p1_e34" edge="1" parent="p1_1" source="p1_L3" style="rounded=1;strokeColor=#000000;" target="p1_L4" value="Ya" />
