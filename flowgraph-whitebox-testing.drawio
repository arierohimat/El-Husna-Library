  <diagram id="fg-pinjam-buku" name="4. Flow Graph - Pinjam Buku (Final)">
    <mxGraphModel dx="1246" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header Title -->
        <mxCell id="title_borrow" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#0d47a1;" value="Flow Graph — Fungsi Transaksi Peminjaman (POST /api/borrowings)&#xa;Pengujian White Box (Basis Path Testing)" vertex="1">
          <mxGeometry height="50" width="800" x="250" y="15" as="geometry" />
        </mxCell>
        
        <!-- Legend Box (Right side) -->
        <mxCell id="legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#cfd8dc;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;fontSize=11;" value="&lt;b style=&quot;font-size:13px; color:#0d47a1;&quot;&gt;METRIK FLOWGRAPH &amp;amp; CYCLOMATIC COMPLEXITY&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border:0; border-top:1px solid #b0bec5;&quot;&gt;&lt;br&gt;&lt;b&gt;1. Jumlah Node (N):&lt;/b&gt; 19 Simpul (1 s.d. 19)&lt;br&gt;&lt;b&gt;2. Jumlah Edge (E):&lt;/b&gt; 24 Transisi Alur Kontrol&lt;br&gt;&lt;b&gt;3. Predicate Nodes (P):&lt;/b&gt; 6 Simpul Percabangan&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; Node 3 (Session valid?)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; Node 6 (Field wajib kosong?)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; Node 8 (dueDate &amp;lt;= borrowDate?)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; Node 10 (Role === &amp;quot;MEMBER&amp;quot;?)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; Node 12 (Peminjaman aktif &amp;gt;= 1?)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;bull; Node 15 (Buku ada &amp;amp; stok &amp;gt; 0?)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px; color:#2e7d32;&quot;&gt;Perhitungan Cyclomatic Complexity V(G):&lt;/b&gt;&lt;br&gt;&amp;bull; Formula Edge-Node: &lt;b&gt;V(G) = E - N + 2&lt;/b&gt; = 24 - 19 + 2 = &lt;b style=&quot;color:#d32f2f;&quot;&gt;7&lt;/b&gt;&lt;br&gt;&amp;bull; Formula Predicate: &lt;b&gt;V(G) = P + 1&lt;/b&gt; = 6 + 1 = &lt;b style=&quot;color:#d32f2f;&quot;&gt;7&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px; color:#0d47a1;&quot;&gt;7 Independent Paths (Basis Paths):&lt;/b&gt;&lt;br&gt;&lt;b&gt;Path 1:&lt;/b&gt; 1-2-3-4-19 &lt;i style=&quot;color:#666;&quot;&gt;(Un-Authenticated)&lt;/i&gt;&lt;br&gt;&lt;b&gt;Path 2:&lt;/b&gt; 1-2-3-5-6-7-19 &lt;i style=&quot;color:#666;&quot;&gt;(Field Kosong)&lt;/i&gt;&lt;br&gt;&lt;b&gt;Path 3:&lt;/b&gt; 1-2-3-5-6-8-9-19 &lt;i style=&quot;color:#666;&quot;&gt;(Tanggal Invalid)&lt;/i&gt;&lt;br&gt;&lt;b&gt;Path 4:&lt;/b&gt; 1-2-3-5-6-8-10-11-12-13-19 &lt;i style=&quot;color:#666;&quot;&gt;(Member Aktif &amp;gt;= 1)&lt;/i&gt;&lt;br&gt;&lt;b&gt;Path 5:&lt;/b&gt; 1-2-3-5-6-8-10-14-15-16-19 &lt;i style=&quot;color:#666;&quot;&gt;(Buku/Stok Habis)&lt;/i&gt;&lt;br&gt;&lt;b&gt;Path 6:&lt;/b&gt; 1-2-3-5-6-8-10-11-12-14-15-17-18-19 &lt;i style=&quot;color:#666;&quot;&gt;(Member Sukses)&lt;/i&gt;&lt;br&gt;&lt;b&gt;Path 7:&lt;/b&gt; 1-2-3-5-6-8-10-14-15-17-18-19 &lt;i style=&quot;color:#666;&quot;&gt;(Admin Sukses)&lt;/i&gt;" vertex="1">
          <mxGeometry height="540" width="420" x="800" y="80" as="geometry" />
        </mxCell>

